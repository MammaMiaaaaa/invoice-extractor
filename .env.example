# Required: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override
# GEMINI_MODEL=gemini-2.5-flash

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you invent; paste the same value in WhatsApp > Configuration > Webhook
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (used to verify webhook signatures)
META_APP_SECRET=
# Your ngrok https URL, used for the form link in WhatsApp replies
PUBLIC_URL=

# Google Sheets (optional): service-account JSON path + the sheet ID from its URL
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
SHEET_ID=
# SHEET_TAB=   (optional; defaults to the first tab)

PORT=3000
